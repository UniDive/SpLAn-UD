rule lift_implicit {
  pattern {
		X -[type=attach]-> Y; Y[Promotion]; % Y has be restored after promotion
		Y[upos<>NOUN|VERB|ADJ|ADV];         % Y is a functional word
		e: Y -> Z; Z[!Head];                % Z is dependent of Y with no explicit Head indication
	}
	without {  X -[type=lifted]-> Z; }
	commands {
		% lift up the dependency 
		add_edge f: X -> Z;
		f.label = e.label;
		f.type = lifted;
		% del_edge e;
	}
}

rule lift_explicit {
  pattern {
		X -[type=attach]-> Y; Y[Promotion]; % Y has be restored after promotion
		e: Y -> Z; Z[Head=Position];        % Z is dependent of Y with no explicit Head indication
	}
	commands {
		% lift up the dependency 
		add_edge f: X -> Z;
		f.label = e.label;
		f.type = lifted;
		del_feat Z.Head;
		% del_edge e;
	}
}

package rm_feats {
	rule rm_prom {
		pattern { X[Promotion] }
		commands { del_feat X.Promotion }
	}
	rule rm_head {
		pattern { X[Head] }
		commands { del_feat X.Head }
	}

rule mark_sb_dep {
	pattern { 
		e: X -[!type]-> Y;
		Z$ -[type=attach|lifted]-> Y;
	}
	commands { e.type=sb }
}

}
strat final {
	Seq (
		Onf (rel),
		Onf (rm_type),
	)
}


rule rel {
	% Y has two governor: a new "attach" one and an old "X" --> remove the dep to X
	pattern { 
		e: X -[type=sb]-> Y;
	}
	commands { del_edge e }
}

rule rm_type {
	pattern { 
		e: X -[type=*]-> Y
	}
	commands { del_feat e.type }
}


