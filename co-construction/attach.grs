strat main { 
	Seq (
		Onf (OBSOLETE_attach_relation),
		Onf (move_root),
		Onf (detect),
		Onf (features),
		Onf (promotion),
		Onf (lift_implicit),
		Onf (lift_explicit),
		Onf (rm_feats),
	)
}

% Move relation name from feature to edge
% Rule specific to former Rhapsodie annotation, not used wih Kiparla
rule OBSOLETE_attach_relation {
	pattern {
		e: X -[ATTACH]-> Y; 
		Y[__MISC__Rel, AttachTo] 
	}
	commands {	
		e.label = Y.__MISC__Rel;
		e.type = "attach";
		del_feat Y.__MISC__Rel;
		del_feat Y.AttachTo;
	}
}

% If "attach" relation are not all left-to-right, the root may not be on the first sentence
% we have to move the root relation to have a tree in the end
rule move_root {
	pattern { e: ANCHOR -[1=root]-> X1; X2 -[type=attach]-> X1 }
	without { X2 -[type=attach]-> X3 }
	commands {
		add_edge f: ANCHOR -> X2; 
		f.label = e.label;
		del_edge e;
	}
}

% Slovenian SST
rule detect { 
	pattern { e: ANCHOR -[1=root]-> X1; f1: X2 -[type=attach]-> X1; f2: X2 -[type=attach]-> X3 }
	commands {
		f1.type = tocheck; 
		f2.type = tocheck; 
	}
}

package features {
	rule Coconstruct {
		pattern { X[Coconstruct<>"Yes"] }
		commands { X.Coconstruct="Yes" }
	}
	rule Backchannel {
		pattern { X[Backchannel<>"Yes"] }
		commands { X.Backchannel="Yes" }
	}
}

package promotion {
	rule direct {
		pattern { 
			X -[type=attach]-> Y;
			p: X -> Z; Z[Promotion, Scrap];
		}
		commands {
			add_edge e: Y -> Z;
			e.1 = Z.Promotion;
			e.type = attach;
			del_feat Z.Scrap;
		}
	}
}

	% rule one {
	% 	pattern { 
	% 		X -[type=attach]-> Y;
	% 		X -> X1;
	% 		p: X1 -> Z; Z[Promotion];
	% 	}
